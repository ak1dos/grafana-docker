global:
  smtp_smarthost: smtp-relay:587
  smtp_from: alerts@ak1dos.com
  smtp_hello: monitoring.ak1dos.com
  # Plain SMTP only inside homelab-mail; Postfix uses verified TLS to Brevo.
  smtp_require_tls: false
route:
  receiver: email
  group_by: [alertname, host]
  group_wait: 30s
  group_interval: 5m
  repeat_interval: 4h
receivers:
  - name: email
    email_configs:
      - to: alerts@example.invalid
        send_resolved: true
        headers:
          Subject: '[Homelab {{ .Status | toUpper }}] {{ .CommonLabels.alertname }} — {{ .CommonLabels.host }}'
