{
  "uid": "homelab-valheim",
  "title": "Valheim — giocatori, risorse e log",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "homelab"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "links": [
    {
      "title": "Server",
      "url": "/d/homelab-hosts",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Container",
      "url": "/d/homelab-containers",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Log",
      "url": "/d/homelab-logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Valheim",
      "url": "/d/homelab-valheim",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "title": "Giocatori: fonte e attendibilità",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 4
      },
      "options": {
        "mode": "markdown",
        "content": "Conteggio nativo «Connections» dai log del server crossplay, emesso circa ogni **10 minuti**: è l’ultima osservazione, non un contatore in tempo reale. Dopo 15 minuti senza campioni mostra N/D. I nomi dei giocatori non sono forniti da questo segnale. Nessuna modifica al gioco o riavvio del server Valheim."
      }
    },
    {
      "id": 2,
      "title": "Giocatori — ultima rilevazione",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time({host=\"ryzen5lenovo\",container=\"valheim-server\"} | regexp \"Connections (?P<players>[0-9]+) ZDOS:\" | unwrap players | __error__=\"\" [15m]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic",
        "textMode": "auto"
      }
    },
    {
      "id": 3,
      "title": "Ultima rilevazione giocatori",
      "type": "stat",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "gridPos": {
        "x": 6,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "1000 * max(last_over_time({host=\"ryzen5lenovo\",container=\"valheim-server\"} |= \"Connections \" | label_format observed=\"{{ __timestamp__ | unixEpoch }}\" | unwrap observed | __error__=\"\" [15m]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic",
        "textMode": "auto"
      }
    },
    {
      "id": 4,
      "title": "CPU Valheim (core)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(container_cpu_usage_seconds_total{host=\"ryzen5lenovo\",name=\"valheim-server\"}[$__rate_interval]))",
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic",
        "textMode": "auto"
      }
    },
