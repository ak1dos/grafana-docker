    {
      "id": 6,
      "title": "Giocatori — storico delle rilevazioni",
      "type": "timeseries",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "Finestra di validità 15 minuti; dati vecchi non sostituiti da zero.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(last_over_time({host=\"ryzen5lenovo\",container=\"valheim-server\"} | regexp \"Connections (?P<players>[0-9]+) ZDOS:\" | unwrap players | __error__=\"\" [15m]))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
