    {
      "id": 10,
      "title": "Eventi — connessioni e salvataggi",
      "type": "logs",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 24,
        "h": 9
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{host=\"ryzen5lenovo\",container=\"valheim-server\"} |~ \"(?i)Got character|ZDOID|Connections [0-9]+|new connection|disconnect|world.*sav|world.*backup|server.*start\"",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": true,
        "enableLogDetails": true,
        "dedupStrategy": "none",
        "sortOrder": "Descending"
      }
    },
