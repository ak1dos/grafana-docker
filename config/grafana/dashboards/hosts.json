      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - node_filesystem_avail_bytes{host=\"$host\",fstype=~\"ext4|xfs|btrfs|zfs|vfat\",mountpoint!~\"/run.*|/var/lib/docker.*\"}/node_filesystem_size_bytes{host=\"$host\",fstype=~\"ext4|xfs|btrfs|zfs|vfat\",mountpoint!~\"/run.*|/var/lib/docker.*\"})",
          "legendFormat": "{{mountpoint}}",
          "instant": true,
          "range": false
