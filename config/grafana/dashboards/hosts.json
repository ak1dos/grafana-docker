          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "CPU occupata nel tempo",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg(rate(node_cpu_seconds_total{host=\"$host\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 7,
      "title": "RAM occupata / disponibile",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 7,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemTotal_bytes{host=\"$host\"}-node_memory_MemAvailable_bytes{host=\"$host\"}",
          "legendFormat": "Usata (totale − disponibile)",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "node_memory_MemAvailable_bytes{host=\"$host\"}",
          "legendFormat": "Disponibile"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
