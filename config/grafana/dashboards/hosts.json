    {
      "id": 10,
      "title": "Dischi — letture e scritture",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 23,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_disk_read_bytes_total{host=\"$host\",device!~\"loop.*|dm-.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} lettura",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(node_disk_written_bytes_total{host=\"$host\",device!~\"loop.*|dm-.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} scrittura"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "Bps",
          "decimals": 1,
          "min": 0,
