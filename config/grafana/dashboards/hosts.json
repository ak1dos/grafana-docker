      "targets": [
        {
          "refId": "A",
          "expr": "rate(node_network_receive_bytes_total{host=\"$host\",device=~\"en.*|eth.*|wg.*\"}[$__rate_interval])",
          "legendFormat": "{{device}} RX",
          "instant": false,
          "range": true
        },
        {
          "refId": "B",
          "expr": "rate(node_network_transmit_bytes_total{host=\"$host\",device=~\"en.*|eth.*|wg.*\"}[$__rate_interval])",
