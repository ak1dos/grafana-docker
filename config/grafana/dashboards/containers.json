{
  "uid": "homelab-containers",
  "title": "Container — consumi e limiti",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "homelab"
  ],
  "editable": false,
  "timezone": "browser",
  "refresh": "30s",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "links": [
    {
      "title": "Server",
      "url": "/d/homelab-hosts",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Container",
      "url": "/d/homelab-containers",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Log",
      "url": "/d/homelab-logs",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    },
    {
      "title": "Valheim",
      "url": "/d/homelab-valheim",
      "type": "link",
      "includeVars": true,
      "keepTime": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Host",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(node_uname_info, host)",
        "definition": "label_values(node_uname_info, host)",
        "refresh": 1,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "allValue": null,
        "current": {
          "text": "fujiserver",
          "value": "fujiserver"
        }
      },
      {
        "name": "container",
        "label": "Container",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": "label_values(container_memory_working_set_bytes{host=\"$host\",name!=\"\"}, name)",
        "definition": "label_values(container_memory_working_set_bytes{host=\"$host\",name!=\"\"}, name)",
        "refresh": 1,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Unità e limiti",
      "type": "text",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "CPU in core: 1 equivale a un core pieno, 2 a due core. Memoria = working set, simile al valore Docker Stats, distinta dalla RAM dell’host. Il limite cgroup dei container senza limite esplicito può coincidere con la memoria dell’host; non è una prenotazione."
      }
    },
    {
      "id": 2,
      "title": "CPU per container (core)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by(name) (rate(container_cpu_usage_seconds_total{host=\"$host\",name=~\"$container\",name!=\"\"}[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 3,
      "title": "Memoria working set",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 3,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by(name) (container_memory_working_set_bytes{host=\"$host\",name=~\"$container\",name!=\"\"})",
          "legendFormat": "{{name}}",
          "instant": false,
          "range": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "calcs": [
            "lastNotNull",
            "max"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "id": 4,
      "title": "Top 10 — CPU (core)",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,sum by(name) (rate(container_cpu_usage_seconds_total{host=\"$host\",name=~\"$container\",name!=\"\"}[$__rate_interval])))",
          "legendFormat": "{{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic",
        "textMode": "auto"
      }
    },
    {
      "id": 5,
      "title": "Top 10 — RAM",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 11,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "topk(10,max by(name) (container_memory_working_set_bytes{host=\"$host\",name=~\"$container\",name!=\"\"}))",
          "legendFormat": "{{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic",
        "textMode": "auto"
      }
    },
    {
      "id": 6,
      "title": "Memoria / limite cgroup",
      "type": "bargauge",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 19,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * max by(name) (container_memory_working_set_bytes{host=\"$host\",name=~\"$container\",name!=\"\"}) / (max by(name) (container_spec_memory_limit_bytes{host=\"$host\",name=~\"$container\",name!=\"\"}) > 0)",
          "legendFormat": "{{name}}",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "decimals": 1,
          "min": 0,
          "noValue": "N/D",
          "color": {
            "mode": "palette-classic"
          },
          "max": 100
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal",
        "colorMode": "value",
        "graphMode": "none",
        "displayMode": "basic",
        "textMode": "auto"
      }
    },
    {
