#!/usr/bin/env python3
"""Check the isolated localhost smoke stack; never targets production."""
import base64
import json
from pathlib import Path
import time
import urllib.error
import urllib.parse
import urllib.request

root = Path('/private/tmp/homelab-rustfs-smoke/runtime')
def env(path):
    return dict(line.split('=', 1) for line in path.read_text().splitlines() if line)
agent = env(root / 'agents/fujiserver.env')
auth = 'Basic ' + base64.b64encode((agent['INGEST_USER'] + ':' + agent['INGEST_PASSWORD']).encode()).decode()
def request(url, data=None, headers=None):
    req = urllib.request.Request(url, data=data, headers=headers or {})
    with urllib.request.urlopen(req, timeout=5) as r:
        return r.status, r.read()
def wait(url):
    deadline = time.monotonic() + 45
    while True:
        try:
            return request(url)
        except (urllib.error.URLError, TimeoutError):
            if time.monotonic() > deadline:
                raise
            time.sleep(1)
wait('http://127.0.0.1:13310/ready')
wait('http://127.0.0.1:13909/-/ready')
wait('http://127.0.0.1:13300/api/health')
try:
    request('http://127.0.0.1:13311/loki/api/v1/push', b'{}')
    raise AssertionError('Unauthenticated ingestion accepted')
except urllib.error.HTTPError as e:
    assert e.code == 401, e.code
stamp = str(time.time_ns())
line = 'homelab-rustfs-smoke-' + stamp
payload = {'streams': [{'stream': {'host': 'smoke', 'job': 'integration'}, 'values': [[stamp, line]]}]}
status, _ = request('http://127.0.0.1:13311/loki/api/v1/push', json.dumps(payload).encode(), {'Authorization': auth, 'Content-Type': 'application/json'})
assert status == 204
query = urllib.parse.urlencode({'query': '{host="smoke",job="integration"}', 'since': '1h'})
_, body = request('http://127.0.0.1:13310/loki/api/v1/query_range?' + query)
assert line.encode() in body, body
request('http://127.0.0.1:13310/flush', b'')
_, body = request('http://127.0.0.1:13909/api/v1/query?' + urllib.parse.urlencode({'query': 'up{host="smoke"}'}))
assert json.loads(body)['data']['result'], body
password = env(root / 'grafana.env')['GF_SECURITY_ADMIN_PASSWORD']
grafana_auth = 'Basic ' + base64.b64encode(('admin:' + password).encode()).decode()
for datasource in ('prometheus', 'loki'):
    _, body = request('http://127.0.0.1:13300/api/datasources/uid/' + datasource + '/health', headers={'Authorization': grafana_auth})
    assert json.loads(body)['status'] == 'OK', body
_, body = request('http://127.0.0.1:13300/api/dashboards/uid/homelab-overview', headers={'Authorization': grafana_auth})
assert json.loads(body)['dashboard']['uid'] == 'homelab-overview'
print('PASS: readiness, auth rejection, Loki push/query/flush, Alloy remote_write, both Grafana datasources and dashboard')
