#!/usr/bin/env python3
"""Prepare a separate localhost test using fresh credentials and named test volumes."""
from pathlib import Path
import shutil
import subprocess
import sys
root = Path(__file__).resolve().parents[1]
target = Path(sys.argv[1]) if len(sys.argv) > 1 else Path('/private/tmp/homelab-rustfs-smoke')
target.mkdir(mode=0o700, parents=True, exist_ok=False)
shutil.copyfile(root / '.env', target / '.env')
for name in ('config', 'storage'):
    shutil.copytree(root / name, target / name)
subprocess.run([sys.executable, str(root/'scripts/bootstrap'), str(target/'runtime')], check=True)
f=target/'runtime/loki.env'
f.write_text(f.read_text().replace('10.20.0.1:19000','rustfs:9000'))
s=(root/'docker-compose.yaml').read_text().split('# Fuji owns the backend')[0].replace('name: homelab-monitoring','name: homelab-rustfs-smoke').replace('192.168.1.54:13000:3000','127.0.0.1:13300:3000').replace('${MONITORING_BIND_IP:?set WireGuard address}:3100:8080','127.0.0.1:13311:8080').replace('  prometheus:\n','  prometheus:\n    ports: ["127.0.0.1:13909:9090"]\n',1).replace('  loki:\n','  loki:\n    ports: ["127.0.0.1:13310:3100"]\n',1)
# Map production host directories to isolated test volumes before adding test services.
for name, destination in [('prometheus', '/prometheus'), ('loki', '/loki'), ('grafana', '/var/lib/grafana')]:
    block = f'      - type: bind\n        source: /srv/homelab-monitoring/{name}\n        target: {destination}\n        bind: {{create_host_path: false}}'
    assert block in s, f'Missing production mount for {name}'
    s = s.replace(block, f'      - {name}-data:{destination}')
s += 'volumes:\n  prometheus-data:\n  grafana-data:\n  loki-data:\n'
# Only the test uses tmpfs: keep Docker Desktop disk pressure out of WAL tests.
s=s.replace('      - loki-data:/loki', '    tmpfs: ["/loki:uid=10001,gid=10001,size=536870912"]')
s=s.replace('volumes:\n  prometheus-data:', '''  rustfs-permissions:
    image: ${RUSTFS_IMAGE:?set RUSTFS_IMAGE in .env}
    user: "0:0"
    entrypoint: [/bin/sh, -ec, "chown 10001:10001 /data /logs"]
    volumes: ["rustfs-data:/data", "rustfs-logs:/logs"]
  rustfs:
    image: ${RUSTFS_IMAGE:?set RUSTFS_IMAGE in .env}
    depends_on:
      rustfs-permissions: {condition: service_completed_successfully}
    env_file: ./runtime/rustfs.env
    environment:
      RUSTFS_VOLUMES: /data
      RUSTFS_ADDRESS: 0.0.0.0:9000
      RUSTFS_CONSOLE_ADDRESS: 0.0.0.0:9001
      RUSTFS_CONSOLE_ENABLE: "true"
      RUSTFS_OBS_LOGGER_LEVEL: warn
      RUSTFS_OBS_LOG_DIRECTORY: /logs
    ports: ["127.0.0.1:13900:9000"]
    volumes: ["rustfs-data:/data", "rustfs-logs:/logs"]
    mem_limit: 768m
  init:
    image: ${MC_IMAGE:?set MC_IMAGE in .env}
    profiles: [bootstrap]
    env_file: [./runtime/rustfs.env, ./runtime/loki.env]
    entrypoint: [/bin/sh, /bootstrap/init.sh]
    volumes:
      - ./storage/init.sh:/bootstrap/init.sh:ro
      - ./storage/loki-policy.json:/bootstrap/loki-policy.json:ro
volumes:
  rustfs-data:
  rustfs-logs:
  prometheus-data:''')
(target/'compose.yaml').write_text(s)
(target/'smoke.alloy').write_text('''prometheus.scrape "test" {
  targets = [{__address__ = "prometheus:9090", host = "smoke"}]
  scrape_interval = "5s"
  scrape_timeout = "4s"
  forward_to = [prometheus.remote_write.test.receiver]
}
prometheus.remote_write "test" {
  endpoint {
    url = "http://gateway:8080/api/v1/write"
    basic_auth {
      username = sys.env("INGEST_USER")
      password = sys.env("INGEST_PASSWORD")
    }
  }
}
''')
print('Prepared isolated RustFS test tree.')
