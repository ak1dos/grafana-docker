#!/usr/bin/env python3
"""Test only the fixed, isolated RustFS smoke stack; never production."""
import json
from pathlib import Path
import subprocess
import time
import urllib.error
import urllib.parse
import urllib.request

root = Path('/private/tmp/homelab-rustfs-smoke')
compose = ['docker', 'compose', '-f', str(root / 'compose.yaml')]
reader = 'homelab-rustfs-smoke-reader'
query = urllib.parse.urlencode({'query': '{host="smoke",job="integration"}', 'since': '1h'})
def get(port):
    with urllib.request.urlopen(f'http://127.0.0.1:{port}/loki/api/v1/query_range?{query}', timeout=5) as response:
        return json.load(response)['data']['result']
def lines(streams):
    return {line for stream in streams for _, line in stream['values']}
expected = lines(get(13310))
assert expected, 'Run check-smoke first'
subprocess.run(compose + ['stop', '-t', '30', 'loki'], check=True)
subprocess.run(compose + ['start', 'loki'], check=True)
config = root / 'config/loki/reader.yml'
config.write_text((root / 'config/loki/loki.yml').read_text().replace('common:\n', 'common:\n  compactor_address: http://loki:3100\n'))
subprocess.run(['docker', 'run', '-d', '--name', reader, '--network', 'homelab-rustfs-smoke_default', '-p', '127.0.0.1:13312:3100', '--env-file', str(root / 'runtime/loki.env'), '-v', str(root / 'config/loki') + ':/etc/loki:ro', '--tmpfs', '/loki:uid=10001,gid=10001', 'grafana/loki:3.7.7', '-config.file=/etc/loki/reader.yml', '-config.expand-env=true', '-target=read,query-scheduler', '-querier.query-store-only=true'], check=True, stdout=subprocess.DEVNULL)
try:
    deadline = time.monotonic() + 90
    while True:
        try:
            found = lines(get(13312))
            if expected <= found:
                print(f'PASS: {len(expected)} log lines recovered from RustFS with a fresh Loki reader, no original WAL/index/cache')
                break
        except (urllib.error.URLError, TimeoutError, ConnectionError):
            pass
        if time.monotonic() >= deadline:
            raise RuntimeError('S3 recovery did not return all expected test log lines')
        time.sleep(2)
finally:
    subprocess.run(['docker', 'rm', '-f', reader], check=True, stdout=subprocess.DEVNULL)
