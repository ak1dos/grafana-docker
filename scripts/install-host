#!/bin/bash
# Run on the intended Linux host, as root, from the reviewed checkout.
set -euo pipefail
[[ $EUID -eq 0 ]] || { echo 'Run with sudo on the target host.' >&2; exit 1; }
source_dir=$(cd -- "$(dirname -- "$0")/.." && pwd)
node=$(hostname -s)
case "$node" in
  fujiserver) vpn_ip=10.20.0.1 ;;
  ryzen5lenovo) vpn_ip=10.20.0.5 ;;
  *) echo "Unsupported host: $node" >&2; exit 1 ;;
esac
if [[ $node == fujiserver ]]; then
  required_files=(rustfs.env loki.env grafana.env ingest.htpasswd alertmanager.yml)
else
  required_files=()
fi
for file in "${required_files[@]}"; do
  [[ -s "$source_dir/runtime/$file" ]] || { echo "Missing runtime/$file" >&2; exit 1; }
done
command -v docker >/dev/null
docker compose version >/dev/null
[[ -f "$source_dir/runtime/agents/$node.env" ]] || { echo 'Missing host secrets.' >&2; exit 1; }
# Refuse a silent switch from a previous named-volume deployment.
for volume in homelab-monitoring_prometheus-data homelab-monitoring_loki-data homelab-monitoring_grafana-data homelab-telemetry_alloy-data; do
  if docker volume inspect "$volume" >/dev/null 2>&1; then
    echo "Existing volume $volume: migrate its data before installing bind mounts." >&2
    exit 1
  fi
done
install -d -m 0755 /srv/homelab-monitoring
install -d -o 0 -g 0 -m 0700 /srv/homelab-monitoring/alloy
if [[ $node == fujiserver ]]; then
  docker network inspect homelab-mail >/dev/null
  install -d -o 1000 -g 1000 -m 0700 /srv/homelab-monitoring/alertmanager
  install -d -o 65534 -g 65534 -m 0700 /srv/homelab-monitoring/prometheus
  install -d -o 10001 -g 10001 -m 0700 /srv/homelab-monitoring/loki
  install -d -o 472 -g 0 -m 0700 /srv/homelab-monitoring/grafana
fi
# Validate mount BEFORE creating any application directory on the DAS.
if [[ $node == fujiserver ]]; then
  command -v zfs >/dev/null
  zpool list tank >/dev/null
  if ! zfs list tank/observability >/dev/null 2>&1; then
    [[ ! -e /tank/observability ]] || { echo 'Unmanaged path /tank/observability exists; inspect manually.' >&2; exit 1; }
    zfs create -o mountpoint=/tank/observability -o quota=128G -o compression=lz4 -o atime=off tank/observability
  fi
  [[ $(findmnt -n -o SOURCE --target /tank/observability) == tank/observability ]] || { echo 'Dataset not mounted at expected path.' >&2; exit 1; }
  [[ $(zfs get -H -o value quota tank/observability) != none ]] || { echo 'Set a reviewed dataset quota first.' >&2; exit 1; }
  install -d -m 0700 /tank/observability/rustfs
  install -d -o 10001 -g 10001 -m 0700 /tank/observability/rustfs/data /tank/observability/rustfs/logs
fi
# Root-owned application files; private credentials readable by the Docker operator.
dest=/opt/applications/homelab-monitoring
install -d -m 0755 "$dest"
for item in docker-compose.yaml config agents storage scripts; do
  cp -a "$source_dir/$item" "$dest/"
done
install -d -m 0700 "$dest/runtime"
install -m 0600 "$source_dir/runtime/agents/$node.env" "$dest/runtime/agent.env"
if [[ $node == fujiserver ]]; then
  for file in rustfs.env loki.env grafana.env ingest.htpasswd alertmanager.yml; do
    install -m 0600 "$source_dir/runtime/$file" "$dest/runtime/$file"
  done
  printf 'MONITORING_BIND_IP=10.20.0.1\n' > "$dest/.env"
  sed -i 's/^S3_ENDPOINT=.*/S3_ENDPOINT=rustfs:9000/' "$dest/runtime/loki.env"
else
  sed -e 's#./config.alloy:#./agents/config.alloy:#' -e 's#../runtime/agent.env#./runtime/agent.env#' "$dest/agents/compose.yaml" > "$dest/docker-compose.yaml"
fi
sed -i 's#^INGEST_URL=.*#INGEST_URL=http://10.20.0.1:3100#' "$dest/runtime/agent.env"
chown -R root:root "$dest"
chmod 0755 "$dest/scripts/"*
bash "$dest/scripts/setup-compose-access"
cd "$dest"
docker compose config -q
# Retire the old supervisors before handing lifecycle ownership to Docker.
for unit in homelab-object-storage homelab-monitoring homelab-telemetry; do
  if [[ -f /etc/systemd/system/$unit.service ]]; then
    systemctl disable --now "$unit.service"
  fi
done
if [[ $node == fujiserver ]]; then
  docker compose up -d --wait --wait-timeout 180 rustfs
  docker compose --profile bootstrap run --rm init
fi
docker compose up -d
printf 'Installed on %s. Manage services with docker compose from %s.\n' "$node" "$dest"
