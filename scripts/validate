#!/bin/bash
set -euo pipefail
cd -- "$(dirname -- "$0")/.."
repo_dir=$PWD
python3 -m unittest discover -s tests -v
bash -n scripts/install-host scripts/wait-vpn scripts/setup-compose-access
sh -n storage/init.sh storage/start-rustfs.sh
MONITORING_BIND_IP=10.20.0.5 docker compose config -q
docker compose -f storage/compose.yaml config -q
docker compose -f agents/compose.yaml config -q
docker run --rm -v "$repo_dir/config/prometheus:/etc/prometheus:ro" --entrypoint promtool prom/prometheus:v3.14.0 check config /etc/prometheus/prometheus.yml
docker run --rm -v "$repo_dir/config/loki:/etc/loki:ro" --env-file runtime/loki.env grafana/loki:3.7.7 -config.file=/etc/loki/loki.yml -config.expand-env=true -verify-config=true
docker run --rm -v "$repo_dir/agents:/etc/alloy:ro" --env-file runtime/agent.env grafana/alloy:v1.19.2 validate /etc/alloy/config.alloy
docker run --rm -v "$repo_dir/config/gateway/nginx.conf:/etc/nginx/nginx.conf:ro" nginx:1.28.0-alpine nginx -t
git diff --check
