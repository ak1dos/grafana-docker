#!/usr/bin/env python3
"""Generate new deployment secrets privately; never overwrite an existing directory."""
import os
from pathlib import Path
import secrets
import subprocess
import sys


def generate(target):
    os.umask(0o077)
    target.mkdir(mode=0o700, parents=True, exist_ok=False)
    (target / "agents").mkdir(mode=0o700)
    def write(name, value):
        with (target / name).open("x") as stream:
            stream.write(value)
    key = "LOKI" + secrets.token_hex(8).upper()
    secret = secrets.token_hex(32)
    admin_key = "ADMIN" + secrets.token_hex(8).upper()
    admin_secret = secrets.token_hex(32)
    rpc_secret = secrets.token_hex(32)
    write("rustfs.env", f"RUSTFS_ACCESS_KEY={admin_key}\nRUSTFS_SECRET_KEY={admin_secret}\nRUSTFS_RPC_SECRET={rpc_secret}\n")
    write("loki.env", f"S3_ENDPOINT=rustfs:9000\nS3_REGION=us-east-1\nS3_ACCESS_KEY={key}\nS3_SECRET_KEY={secret}\n")
    write("grafana.env", "GF_SECURITY_ADMIN_PASSWORD=" + secrets.token_urlsafe(32) + "\n")
    passwd = []
    for host in ("fujiserver", "ryzen5lenovo"):
        password = secrets.token_urlsafe(32)
        hashed = subprocess.run(["openssl", "passwd", "-apr1", "-stdin"], input=password + "\n", text=True, capture_output=True, check=True).stdout.strip()
        passwd.append(host + ":" + hashed)
        write("agents/" + host + ".env", f"HOST_LABEL={host}\nINGEST_URL=http://10.20.0.1:3100\nINGEST_USER={host}\nINGEST_PASSWORD={password}\n")
    write("ingest.htpasswd", "\n".join(passwd) + "\n")


if __name__ == "__main__":
    generate(Path(sys.argv[1]) if len(sys.argv) > 1 else Path(__file__).resolve().parents[1] / "runtime")
    print("Private runtime generated. No secret values printed.")
